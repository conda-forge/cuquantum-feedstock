#!/usr/bin/env bash
# shellcheck disable=SC1090
# shellcheck disable=SC1091
set -ex

declare -gx FILES_LIB="./common/handle-files"
if ! [[ -f "${FILES_LIB}" ]] ; then
  echo "error: files-lib is not available"
  exit 1
else
  source "${FILES_LIB}"
fi

declare -agx filepaths=(
  "${PREFIX}/include/cudensitymat.h"
  "${PREFIX}/include/cupauliprop.h"
  "${PREFIX}/include/custabilizer.h"
  "${PREFIX}/include/custabilizer.hpp"
  "${PREFIX}/include/custatevec.h"
  "${PREFIX}/include/custatevecEx.h"
  "${PREFIX}/include/custatevecEx_ext.h"
  "${PREFIX}/include/cutensornet.h"
  "${PREFIX}/include/cutensornet/types.h"
  "${PREFIX}/include/cutensornet/typesDistributed.h"
  "${PREFIX}/lib/libcudensitymat.so"
  "${PREFIX}/lib/libcupauliprop.so"
  "${PREFIX}/lib/libcustabilizer.so"
  "${PREFIX}/lib/libcustatevec.so"
  "${PREFIX}/lib/libcutensornet.so"
)

if ! files exist "${filepaths[@]}" ; then
  echo "error: cuquantum files are not available"
  exit 1
fi

declare -agx supported_platforms
supported_platforms=(
  "linux-64"
  "linux-aarch64"
)

declare -Agx cuda_stub_library
cuda_stub_library=(
  ["linux-64"]="${PREFIX}/targets/x86_64-linux/lib/stubs/libcuda.so"
  ["linux-aarch64"]="${PREFIX}/targets/sbsa-linux/lib/stubs/libcuda.so"
)

declare -gx CUDA_STUB_LIBRARY
declare platform ; for platform in "${supported_platforms[@]}" ; do
  if [[ "${target_platform}" == "${platform}" ]] ; then
    CUDA_STUB_LIBRARY="${cuda_stub_library[${platform}]}"
  fi
done


# every binding module shipped by cuQuantum Python must be importable
declare -agx modules=(
  "cuquantum"
  "cuquantum.bindings.custatevec"
  "cuquantum.bindings.custatevecEx"
  "cuquantum.bindings.cutensornet"
  "cuquantum.bindings.cudensitymat"
  "cuquantum.bindings.cupauliprop"
  "cuquantum.bindings.custabilizer"
)
declare module ; for module in "${modules[@]}" ; do
  LD_PRELOAD="${CUDA_STUB_LIBRARY}" python -c "import ${module}"
done
echo "cuQuantum Python and submodules are importable."

# every component library must be discoverable through the CLI helper
declare -agx targets=(
  "custatevec"
  "cutensornet"
  "cudensitymat"
  "cupauliprop"
  "custabilizer"
)
declare target ; for target in "${targets[@]}" ; do
  LD_PRELOAD="${CUDA_STUB_LIBRARY}" python -m cuquantum --includes --libs --target "${target}"
  echo "cuQuantum Python ${target} module is functional"
done
